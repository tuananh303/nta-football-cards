<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình IIS làm reverse proxy cho Album Thẻ Bóng Đá.
  IIS nhận truy cập từ tên miền rồi chuyển tiếp sang ứng dụng Node.js chạy ở http://127.0.0.1:3000.
  Cần cài: URL Rewrite 2.1 và Application Request Routing 3.0 (bật "Enable proxy").
  Đặt file này vào thư mục gốc của website trong IIS (thư mục này chỉ cần chứa web.config).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Truy cập qua https: báo cho Node biết để cookie đăng nhập được đặt cờ Secure -->
        <rule name="Node qua HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^ON$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
        <rule name="Node qua HTTP" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Cho phép tải lên tới 300MB (nhập file sao lưu kèm ảnh) -->
        <requestLimits maxAllowedContentLength="314572800" />
      </requestFiltering>
    </security>

    <!-- Giữ nguyên thông báo lỗi tiếng Việt do ứng dụng trả về, không thay bằng trang lỗi của IIS -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
