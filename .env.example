# Cổng chạy ứng dụng
PORT=3000
# production khi chạy trên máy chủ có https; development khi chạy trên máy (http://localhost)
NODE_ENV=production

# Tài khoản admin duy nhất
ADMIN_USERNAME=admin
# Tạo bằng: npm run hash-password -- "mat-khau-cua-ban"
# Đặt chuỗi trong dấu nháy đơn vì có ký tự $
ADMIN_PASSWORD_HASH=''
# Chuỗi ngẫu nhiên dài ít nhất 32 ký tự, tạo bằng:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Cơ sở dữ liệu: mssql (SQL Server), mysql hoặc sqlite (chạy thử nhanh, không cần cài gì)
DB_CLIENT=mssql
DB_HOST=localhost
# SQL Server có instance tên riêng (VD: localhost\TUANANH) thì điền TUANANH và bỏ qua DB_PORT
DB_INSTANCE=
DB_PORT=1433
DB_NAME=Football card
DB_USER=
DB_PASSWORD=
# Máy chủ SQL trên cloud (VD: Azure SQL) cần DB_ENCRYPT=true
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Thư mục lưu ảnh thẻ. Trên máy chủ nên đặt NGOÀI thư mục code
# để cập nhật code không làm mất ảnh, ví dụ: D:\album-uploads
UPLOAD_DIR=./uploads
